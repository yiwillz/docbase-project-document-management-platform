# docbase 配置（安装脚本生成；升级时保留）。改完重启服务生效：
#   Restart-Service docbase-api, docbase-worker
# 说明见 docs/install-windows.md

# 数据库（安装时自动建的账号和随机密码）
DOCBASE_DATABASE_URL={{DATABASE_URL}}

# 文件存储（外接盘）、备份目录、日志目录
DOCBASE_DATA_DIR={{DATA_DIR}}
DOCBASE_BACKUP_DIR={{BACKUP_DIR}}
DOCBASE_LOG_DIR={{LOG_DIR}}

# 前端页面、PostgreSQL 命令所在目录（备份用）
DOCBASE_FRONTEND_DIR={{FRONTEND_DIR}}
DOCBASE_PG_BIN={{PG_BIN}}

# 每天几点备份、几点做例行清理；备份和日志保留天数
DOCBASE_BACKUP_HOUR=1
DOCBASE_MAINTENANCE_HOUR=2
DOCBASE_BACKUP_DAYS=30
DOCBASE_LOG_DAYS=30
DOCBASE_LOG_MAX_MB=500

# 供应商 / 我方文件保留版本数、回收区保留天数
DOCBASE_KEEP_VERSIONS=3
DOCBASE_RECYCLE_DAYS=90

# 登录：多久不用自动退出（小时）、密码最短几位
DOCBASE_SESSION_HOURS=12
DOCBASE_PASSWORD_MIN_LENGTH=8

# 存量导入允许读取的目录（多个用 ; 分隔）；空着表示不允许导入
# DOCBASE_IMPORT_ROOTS=\\fileserver\projects;D:\old-projects

# 共享盘只读镜像（可不填）；link 硬链接（共享必须设成只读）/ copy 复制
# DOCBASE_MIRROR_DIR=E:\docbase-mirror
# DOCBASE_MIRROR_MODE=link
