# docker compose 用的设置（docker-install.sh 会按它生成 .env；手动部署时复制成 .env 再改）

# 镜像版本（docker load 进来的镜像的标签）
DOCBASE_VERSION=latest
# 数据库密码（随机生成，不要用这个示例值）
DB_PASSWORD=change-me
# 访问地址：IP 或名字，多个用逗号分隔；http 会自动跳到 https
SITE_ADDRESS="https://192.168.1.50, https://localhost"
HTTPS_PORT=443
HTTP_PORT=80
# 宿主机上的目录（要给 uid 10001 写权限：sudo chown -R 10001:10001 目录）
DATA_DIR=/srv/docbase/data
BACKUP_DIR=/srv/docbase/backup
LOG_DIR=/srv/docbase/logs
# 每天几点备份、保留几天；时区（备份时间按它算），如 Asia/Shanghai、Pacific/Auckland
BACKUP_HOUR=1
BACKUP_DAYS=30
TZ=UTC
