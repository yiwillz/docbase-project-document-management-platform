# 复制本文件为 backend/.env，按本机情况修改（.env 不提交仓库）

# 正式库
DOCBASE_DATABASE_URL=postgresql+psycopg://postgres:你的密码@localhost:5432/docbase
# 测试库（pytest 用，必须和正式库不同）
DOCBASE_TEST_DATABASE_URL=postgresql+psycopg://postgres:你的密码@localhost:5432/docbase_test

# 文件存储根目录（运行机上指向外接盘，如 E:/docbase-data）
DOCBASE_DATA_DIR=D:/docbase-data
# 共享盘只读镜像目录（可不填）
# DOCBASE_MIRROR_DIR=D:/docbase-mirror
# 镜像方式：link 硬链接（默认；共享必须由 IT 设成只读）/ copy 复制
# DOCBASE_MIRROR_MODE=link
# 镜像里文件夹名的语言：zh / en
# DOCBASE_MIRROR_LANG=zh
# 交付包做好后保留几天
# DOCBASE_PACKAGE_DAYS=7

# 供应商 / 我方文件保留版本数、回收区保留天数
DOCBASE_KEEP_VERSIONS=3
DOCBASE_RECYCLE_DAYS=90

# 存量导入允许读取的目录（多个用 ; 分隔）；空着表示不允许导入
# DOCBASE_IMPORT_ROOTS=//fileserver/projects;D:/old-projects
# 后台 worker 每天几点做例行清理（回收区满期、没人引用的文件、过期暂存）
DOCBASE_MAINTENANCE_HOUR=2

# 启动时自动执行数据库迁移（true / false）
DOCBASE_AUTO_MIGRATE=true

# 日志目录：不填只打印到控制台（开发时）；填了按天写 api-日期.log、worker-日期.log
# DOCBASE_LOG_DIR=D:/docbase-logs
# DOCBASE_LOG_DAYS=30
# DOCBASE_LOG_MAX_MB=500

# 备份目录：不填不自动备份（系统管理员会看到提醒）；worker 每天 DOCBASE_BACKUP_HOUR 点备份，保留 DOCBASE_BACKUP_DAYS 天
# DOCBASE_BACKUP_DIR=D:/docbase-backup
# DOCBASE_BACKUP_HOUR=1
# DOCBASE_BACKUP_DAYS=30
# PostgreSQL 命令目录（pg_dump / pg_restore）；不填自动找
# DOCBASE_PG_BIN=C:/Program Files/PostgreSQL/17/bin
